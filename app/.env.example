# Template for app/.env.local — copy this file to .env.local and fill in
# real values. Both .env and .env.local are gitignored; CI sources every
# key below from GitHub Variables / Secrets (see .github/workflows/
# build-* and e2e-* for the wiring).

# Backend
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google OAuth client IDs (audience values verified by the backend).
# See app/README.md "Google OAuth setup" for how to create these.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Build identifiers consumed by app.config.ts at prebuild time and by
# Fastlane / Maestro / CI workflows.
APP_BUNDLE_IDENTIFIER=com.dlddu.dearbaby
APP_ANDROID_PACKAGE=com.dlddu.dearbaby
# The reversed-client-id URL scheme from your iOS Google OAuth client.
# Matches the prefix `com.googleusercontent.apps.<client-id-stem>`.
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.<client-id-stem>
# Apple Developer team ID (10-char alphanumeric).
APPLE_TEAM_ID=
