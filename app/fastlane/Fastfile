require "json"
require "base64"

default_platform(:ios)

# Single source of truth for the Apple Team ID lives in app.json under
# ios.appleTeamId — Expo prebuild reads it from there to stamp
# DEVELOPMENT_TEAM into the Xcode project, so this lane reuses the same
# value to avoid drift between TestFlight and prebuild.
APP_JSON = JSON.parse(File.read(File.expand_path("../app.json", __dir__))).fetch("expo").freeze
APPLE_TEAM_ID = APP_JSON.fetch("ios").fetch("appleTeamId").freeze
BUNDLE_IDENTIFIER = APP_JSON.fetch("ios").fetch("bundleIdentifier").freeze
ANDROID_PACKAGE_NAME = APP_JSON.fetch("android").fetch("package").freeze

platform :ios do
  desc "Build the iOS app and upload it to TestFlight (internal testers only)"
  lane :beta do
    build_release_ipa
    api_key = load_app_store_connect_api_key

    changelog = "PR ##{ENV['PR_NUMBER']} · #{ENV['GIT_SHA'].to_s[0, 7]}"

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: changelog,
    )
  end

  desc "Promote an already-uploaded TestFlight build to the external group and submit it for Beta App Review"
  lane :external_beta do
    require_external_beta_env!

    build_number = ENV["TESTFLIGHT_BUILD_NUMBER"]
    UI.user_error!("TESTFLIGHT_BUILD_NUMBER must be set") if build_number.to_s.empty?

    api_key = load_app_store_connect_api_key

    app_version = APP_JSON.fetch("version")
    short_sha = ENV["GIT_SHA"].to_s[0, 7]
    whats_new = ENV["TESTFLIGHT_WHATS_NEW"].to_s.empty? \
      ? "Build #{short_sha} (#{build_number})" \
      : ENV["TESTFLIGHT_WHATS_NEW"]

    groups = ENV["TESTFLIGHT_EXTERNAL_GROUP"].to_s.split(",").map(&:strip).reject(&:empty?)

    # Locale used for App Store Connect localized review metadata. Must
    # match the primary locale configured for the app on App Store
    # Connect, otherwise the upload will be rejected.
    locale = ENV["TESTFLIGHT_REVIEW_LOCALE"]

    # `distribute_only: true` skips the IPA upload entirely and just
    # promotes the build identified by (app_version, build_number) — the
    # one that `:beta` already pushed to TestFlight on the corresponding
    # PR run — to the external group with review metadata applied.
    upload_to_testflight(
      api_key: api_key,
      app_platform: "ios",
      app_identifier: BUNDLE_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      distribute_only: true,
      distribute_external: true,
      notify_external_testers: true,
      groups: groups,
      beta_app_review_info: {
        contact_email: ENV["TESTFLIGHT_BETA_CONTACT_EMAIL"],
        contact_first_name: ENV["TESTFLIGHT_BETA_CONTACT_FIRST_NAME"],
        contact_last_name: ENV["TESTFLIGHT_BETA_CONTACT_LAST_NAME"],
        contact_phone: ENV["TESTFLIGHT_BETA_CONTACT_PHONE"],
        demo_account_name: ENV["TESTFLIGHT_DEMO_ACCOUNT_EMAIL"],
        demo_account_password: ENV["TESTFLIGHT_DEMO_ACCOUNT_PASSWORD"],
        demo_account_required: true,
        notes: "Submitted from GitHub deployment for #{short_sha}.",
      },
      localized_app_info: {
        locale => {
          feedback_email: ENV["TESTFLIGHT_BETA_FEEDBACK_EMAIL"],
          privacy_policy_url: ENV["TESTFLIGHT_BETA_PRIVACY_URL"],
          description: ENV["TESTFLIGHT_BETA_APP_DESCRIPTION"],
        },
      },
      localized_build_info: {
        locale => {
          whats_new: whats_new,
        },
      },
    )
  end

  desc "Write the next TestFlight buildNumber (latest+1) to BUILD_NUMBER_FILE"
  lane :next_build_number do
    output_path = ENV["BUILD_NUMBER_FILE"]
    UI.user_error!("BUILD_NUMBER_FILE env not set") if output_path.to_s.empty?

    api_key = load_app_store_connect_api_key
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_IDENTIFIER,
      initial_build_number: 0,
    )
    next_bn = latest.to_i + 1
    UI.success("Next TestFlight build number: #{next_bn}")
    # Write to a file rather than stdout — fastlane prefixes everything
    # printed during a lane run, which makes grep-based capture brittle.
    File.write(output_path, next_bn.to_s)
  end

  after_all do |lane|
    cleanup_signing_artifacts
  end

  error do |lane, exception|
    cleanup_signing_artifacts
  end
end

platform :android do
  desc "Build the Android AAB and upload it to Google Play (internal track)"
  lane :play_internal do
    aab_path = build_release_aab
    json_key_path = write_play_store_json_key

    short_sha = ENV["GIT_SHA"].to_s[0, 7]
    pr_number = ENV["PR_NUMBER"].to_s
    release_notes = pr_number.empty? \
      ? "Build #{short_sha}" \
      : "PR ##{pr_number} · #{short_sha}"

    upload_to_play_store(
      package_name: ANDROID_PACKAGE_NAME,
      json_key: json_key_path,
      track: "internal",
      aab: aab_path,
      # `draft`는 internal track에 빌드를 저장만 하고 roll-out은 안 함 —
      # Play Console에서 수동 "Start rollout to Internal testing" 1회
      # 필요. 앱이 "Draft app" 상태(Production 트랙에 release가 한 번도
      # 등록된 적 없음)인 동안 Play API는 `completed`를 거절하므로
      # 그 기간 동안 사용. Production launch 이후 `completed`로 승격해
      # hands-off rollout으로 전환 가능.
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: true,
      validate_only: false,
    )

    UI.success("Uploaded #{aab_path} to Play Store internal track (#{release_notes})")
  end

  desc "Write the next Play Store versionCode (latest+1) to BUILD_NUMBER_FILE"
  lane :next_play_version_code do
    output_path = ENV["BUILD_NUMBER_FILE"]
    UI.user_error!("BUILD_NUMBER_FILE env not set") if output_path.to_s.empty?

    json_key_path = write_play_store_json_key
    # Inspect every track so a higher versionCode previously promoted to
    # alpha/beta/production doesn't get rewound by an internal upload.
    tracks = %w[internal alpha beta production]
    latest = tracks.flat_map do |track|
      begin
        google_play_track_version_codes(
          package_name: ANDROID_PACKAGE_NAME,
          json_key: json_key_path,
          track: track,
        )
      rescue StandardError
        []
      end
    end.map(&:to_i).max || 0

    next_vc = latest + 1
    UI.success("Next Play Store versionCode: #{next_vc}")
    File.write(output_path, next_vc.to_s)
  end

  after_all do |lane|
    cleanup_android_signing_artifacts
  end

  error do |lane, exception|
    cleanup_android_signing_artifacts
  end
end

# Build pipeline: prepares signing material from CI secrets and produces
# a Release IPA via gym. Used by `:beta` (internal-only PR previews).
# `:external_beta` reuses the IPA `:beta` already pushed to TestFlight,
# so it doesn't go through this helper.
def build_release_ipa
  setup_ci

  # Resolve the workspace (produced by `expo prebuild`) relative to this
  # Fastfile so the lane is invariant to where it is invoked from.
  ios_dir = File.expand_path("../ios", __dir__)
  workspace = Dir.glob("#{ios_dir}/*.xcworkspace").first
  UI.user_error!("No .xcworkspace found under #{ios_dir}. Did you run `expo prebuild`?") unless workspace
  scheme = File.basename(workspace, ".xcworkspace")

  tmp_dir = ENV["RUNNER_TEMP"] || Dir.mktmpdir("fastlane-signing")
  FileUtils.mkdir_p(tmp_dir)
  cert_path = File.join(tmp_dir, "ios_distribution.p12")
  profile_path = File.join(tmp_dir, "profile.mobileprovision")

  # Decode the distribution certificate and provisioning profile from the
  # base64-encoded secrets injected by CI. Format matches PR #7's
  # `testflight.yml` (reverted) so the existing GitHub Actions secrets can
  # be reused verbatim.
  sh("echo \"$IOS_DISTRIBUTION_CERTIFICATE_BASE64\" | base64 --decode -o #{cert_path.shellescape}")
  sh("echo \"$IOS_PROVISIONING_PROFILE_BASE64\" | base64 --decode -o #{profile_path.shellescape}")

  keychain_name = "fastlane_tmp_keychain"
  keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"] || SecureRandom.hex(16)

  create_keychain(
    name: keychain_name,
    password: keychain_password,
    default_keychain: false,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: false,
  )

  import_certificate(
    certificate_path: cert_path,
    certificate_password: ENV["IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"],
    keychain_name: keychain_name,
    keychain_password: keychain_password,
  )

  install_provisioning_profile(path: profile_path)

  # Derive the profile's display name at runtime so the Fastfile never
  # hardcodes it. Mirrors the pattern from PR #7's testflight.yml.
  profile_name = sh(
    "security cms -D -i #{profile_path.shellescape} | plutil -extract Name raw -",
    log: false,
  ).strip

  build_app(
    workspace: workspace,
    scheme: scheme,
    configuration: "Release",
    export_method: "app-store",
    clean: true,
    output_directory: File.expand_path("../build", __dir__),
    xcargs: [
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
      "DEVELOPMENT_TEAM=#{APPLE_TEAM_ID}",
      "PROVISIONING_PROFILE_SPECIFIER=#{profile_name.shellescape}",
    ].join(" "),
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: APPLE_TEAM_ID,
      provisioningProfiles: {
        BUNDLE_IDENTIFIER => profile_name,
      },
    },
  )
end

# Writes the App Store Connect API key to disk in the exact format PR #7
# used and returns a fastlane-compatible api_key handle. The
# `APP_STORE_CONNECT_API_KEY` secret is the raw .p8 contents (NOT base64),
# so we must not decode it.
def load_app_store_connect_api_key
  api_key_dir = File.expand_path("~/private_keys")
  FileUtils.mkdir_p(api_key_dir)
  api_key_path = File.join(api_key_dir, "AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_ID']}.p8")
  File.write(api_key_path, ENV["APP_STORE_CONNECT_API_KEY"])

  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_filepath: api_key_path,
    in_house: false,
  )
end

# Fail fast at the start of the lane so we surface missing review
# metadata before hitting App Store Connect at all.
EXTERNAL_BETA_REQUIRED_ENV = %w[
  TESTFLIGHT_EXTERNAL_GROUP
  TESTFLIGHT_BETA_CONTACT_FIRST_NAME
  TESTFLIGHT_BETA_CONTACT_LAST_NAME
  TESTFLIGHT_BETA_CONTACT_EMAIL
  TESTFLIGHT_BETA_CONTACT_PHONE
  TESTFLIGHT_BETA_FEEDBACK_EMAIL
  TESTFLIGHT_BETA_PRIVACY_URL
  TESTFLIGHT_BETA_APP_DESCRIPTION
  TESTFLIGHT_DEMO_ACCOUNT_EMAIL
  TESTFLIGHT_DEMO_ACCOUNT_PASSWORD
  TESTFLIGHT_REVIEW_LOCALE
].freeze

def require_external_beta_env!
  missing = EXTERNAL_BETA_REQUIRED_ENV.select { |k| ENV[k].to_s.empty? }
  return if missing.empty?

  UI.user_error!("Missing required env vars for external_beta: #{missing.join(', ')}")
end

def cleanup_signing_artifacts
  sh("security delete-keychain fastlane_tmp_keychain || true", log: false)
  api_key_dir = File.expand_path("~/private_keys")
  FileUtils.rm_rf(api_key_dir) if Dir.exist?(api_key_dir)
end

# Build pipeline: decodes the upload keystore from CI secrets, runs
# `gradlew bundleRelease` with injected signing properties, and returns
# the resulting AAB path. Mirrors `build_release_ipa` for iOS.
def build_release_aab
  android_dir = File.expand_path("../android", __dir__)
  unless Dir.exist?(android_dir)
    UI.user_error!("No android dir at #{android_dir}. Did you run `expo prebuild --platform android`?")
  end

  required = %w[
    ANDROID_KEYSTORE_BASE64
    ANDROID_KEYSTORE_PASSWORD
    ANDROID_KEY_ALIAS
    ANDROID_KEY_PASSWORD
  ]
  missing = required.select { |k| ENV[k].to_s.empty? }
  UI.user_error!("Missing required env vars for android build: #{missing.join(', ')}") unless missing.empty?

  tmp_dir = ENV["RUNNER_TEMP"] || Dir.mktmpdir("fastlane-android-signing")
  FileUtils.mkdir_p(tmp_dir)
  keystore_path = File.join(tmp_dir, "release.keystore")
  sh("echo \"$ANDROID_KEYSTORE_BASE64\" | base64 --decode > #{keystore_path.shellescape}")

  # AGP picks up `android.injected.signing.*` only when the release
  # buildType doesn't already have a signingConfig assigned. The Expo
  # prebuild template assigns `signingConfigs.debug` to the release
  # buildType so debug builds work out of the box; strip that single
  # line from the release block so the injected config takes effect.
  app_build_gradle = File.join(android_dir, "app", "build.gradle")
  patch_release_signing_config!(app_build_gradle)

  gradle(
    project_dir: android_dir,
    task: "bundle",
    build_type: "Release",
    flags: "--no-daemon",
    properties: {
      "android.injected.signing.store.file" => keystore_path,
      "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
      "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
      "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
    },
  )

  aab_path = Actions.lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
  UI.user_error!("gradle did not produce an AAB output path") if aab_path.to_s.empty?
  UI.user_error!("AAB not found at #{aab_path}") unless File.exist?(aab_path)
  aab_path
end

# Removes the `signingConfig signingConfigs.debug` line from the release
# block of app/build.gradle (and only the release block) so AGP's
# injected signing config is what actually signs the AAB.
def patch_release_signing_config!(build_gradle)
  UI.user_error!("Cannot patch missing build.gradle: #{build_gradle}") unless File.exist?(build_gradle)

  lines = File.readlines(build_gradle)
  in_build_types = false
  in_release = false
  brace_depth = 0
  patched = false

  lines.each_with_index do |line, idx|
    in_build_types = true if !in_build_types && line =~ /\bbuildTypes\s*\{/

    if in_build_types && !in_release && line =~ /\brelease\s*\{/
      in_release = true
      brace_depth = line.count("{") - line.count("}")
      next
    end

    if in_release
      brace_depth += line.count("{") - line.count("}")
      if line.include?("signingConfig signingConfigs.debug")
        lines[idx] = line.sub(/^.*signingConfig\s+signingConfigs\.debug.*\n/, "")
        patched = true
      end
      in_release = false if brace_depth <= 0
    end
  end

  if patched
    File.write(build_gradle, lines.join)
    UI.message("Stripped debug signingConfig from release block of #{build_gradle}")
  else
    UI.message("No debug signingConfig assignment found in release block — leaving #{build_gradle} untouched")
  end
end

# Writes the Play Store service account JSON to disk (decoded from the
# raw or base64 form CI provides) and returns the path. Both forms are
# accepted because the GitHub UI strips trailing newlines from secrets,
# which can break some JSON parsers — operators can pre-base64 to
# sidestep that.
def write_play_store_json_key
  raw = ENV["PLAY_STORE_JSON_KEY"].to_s
  b64 = ENV["PLAY_STORE_JSON_KEY_BASE64"].to_s
  UI.user_error!("PLAY_STORE_JSON_KEY or PLAY_STORE_JSON_KEY_BASE64 must be set") if raw.empty? && b64.empty?

  json_dir = File.expand_path("~/private_keys")
  FileUtils.mkdir_p(json_dir)
  json_path = File.join(json_dir, "play_store_service_account.json")

  contents = raw.empty? ? Base64.decode64(b64) : raw
  File.write(json_path, contents)
  json_path
end

def cleanup_android_signing_artifacts
  json_dir = File.expand_path("~/private_keys")
  FileUtils.rm_rf(json_dir) if Dir.exist?(json_dir)
end
