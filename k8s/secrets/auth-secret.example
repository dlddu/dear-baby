# Auth-related backend secrets. Referenced by k8s/deployment.yaml as
# `envFrom: secretRef: name: auth-secret`. Loaded into the container at
# boot; the backend reads the env vars below from os.Getenv (see
# backend/internal/config/config.go).
#
# DO NOT copy this file into the cluster as-is — fill in real values and
# apply, or use `kubectl create secret generic` to skip the
# committed-placeholder problem.
#
# Recommended creation flow (avoids checking placeholder values into git):
#
#   kubectl create secret generic auth-secret \
#     --from-literal=JWT_SECRET="$(openssl rand -hex 32)" \
#     --from-literal=GOOGLE_ALLOWED_AUDIENCES="<ios>,<android>,<web>" \
#     --from-literal=APPLE_TEAM_ID="RBX39XRW2J" \
#     --from-literal=APPLE_CLIENT_ID="com.dlddu.dearbaby" \
#     --from-literal=APPLE_KEY_ID="ABCDEFGHIJ" \
#     --from-file=APPLE_PRIVATE_KEY=./AuthKey_ABCDEFGHIJ.p8 \
#     --from-literal=TEST_USER_EMAIL="tester@dear-baby.app" \
#     --from-literal=TEST_USER_PASSWORD="$(openssl rand -hex 16)"
#
# `--from-file` preserves the real newlines inside the .p8 file. If you
# instead inline the key under stringData below, replace the real
# newlines with literal `\n` — the backend's appleKeyFromEnv() converts
# them back. Either form works.
#
# Required for Google sign-in (POST /auth/google):
#   - JWT_SECRET                  HMAC secret for signing access/refresh JWTs.
#   - GOOGLE_ALLOWED_AUDIENCES    Comma-separated Google OAuth client IDs
#                                 the backend will accept. Usually the iOS,
#                                 Android, and Web client IDs.
#
# Required for Apple sign-in (POST /auth/apple). All four must be set
# together; if any is empty the endpoint returns 503 and Google sign-in
# keeps working:
#   - APPLE_TEAM_ID               10-character Apple Developer Team ID.
#   - APPLE_CLIENT_ID             Bundle ID of the iOS app (or the
#                                 Services ID for web).
#   - APPLE_KEY_ID                10-character Key ID of the .p8 private
#                                 key issued in the Apple Developer
#                                 portal under Keys → "Sign in with
#                                 Apple".
#   - APPLE_PRIVATE_KEY           PEM contents of the .p8 file. Real
#                                 newlines OR literal `\n` sequences are
#                                 both accepted (see config.go).
#
# Optional alternative for the .p8 key:
#   - APPLE_PRIVATE_KEY_PATH      Path to the .p8 file on disk. Useful
#                                 when mounting the key as a separate
#                                 file via `volumes:` — then this Secret
#                                 only carries the path string. Ignored
#                                 when APPLE_PRIVATE_KEY is set.
#
# Required for the password-backed test account that Apple beta
# reviewers and the Maestro E2E flow use (POST /auth/password-login).
# Email + Password must be set together; absence skips seeding and the
# password sign-in path returns 401 for every request. This is the
# same code path that runs in production — gating is the secret tap
# pattern on the landing screen plus knowledge of the password.
#   - TEST_USER_EMAIL             Email of the seeded tester account.
#   - TEST_USER_PASSWORD          Plaintext password; bcrypt-hashed at
#                                 boot and stored in
#                                 password_credentials. Rotate by
#                                 updating this secret and restarting
#                                 the deployment.
#   - TEST_USER_NAME              Optional display name; falls back to
#                                 TEST_USER_EMAIL when empty.
apiVersion: v1
kind: Secret
metadata:
  name: auth-secret
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_WITH_RANDOM_64_HEX_CHARS"
  GOOGLE_ALLOWED_AUDIENCES: "REPLACE_IOS_CLIENT_ID,REPLACE_ANDROID_CLIENT_ID,REPLACE_WEB_CLIENT_ID"
  APPLE_TEAM_ID: "RBX39XRW2J"
  APPLE_CLIENT_ID: "com.dlddu.dearbaby"
  APPLE_KEY_ID: "REPLACE_KEY_ID"
  # Inline form — replace the entire block (BEGIN…END) with the real
  # contents. Keep the leading/trailing lines and the ASCII-armored body.
  # Either real newlines (block scalar `|`) or literal `\n` sequences
  # work; the backend normalizes both to real newlines.
  APPLE_PRIVATE_KEY: |
    -----BEGIN PRIVATE KEY-----
    REPLACE_WITH_BASE64_BODY_OF_THE_P8_FILE
    -----END PRIVATE KEY-----
  TEST_USER_EMAIL: "tester@dear-baby.app"
  TEST_USER_PASSWORD: "REPLACE_WITH_STRONG_RANDOM_PASSWORD"
  TEST_USER_NAME: "App Store Tester"
