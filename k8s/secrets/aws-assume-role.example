# Backend-only. Do NOT copy this file into the cluster as-is; fill in
# real values and apply with `kubectl apply -f aws-assume-role.yaml`.
#
# Tip: use `kubectl create secret generic aws-assume-role \
#   --from-literal=AWS_REGION=ap-northeast-2 \
#   --from-literal=AWS_ASSUME_ROLE_ARN=arn:aws:iam::ACCOUNT:role/dear-baby-records-writer \
#   --from-literal=AWS_S3_BUCKET=dear-baby-records-prod \
#   --from-literal=AWS_S3_KEY_PREFIX=prod/`
# to avoid committing placeholders.
#
# What each var does
# ------------------
# AWS_REGION
#   Required. The region the bucket and STS endpoint live in.
#
# AWS_ASSUME_ROLE_ARN
#   Optional in dev. When set, the backend wraps its ambient credentials
#   chain in stscreds.AssumeRoleProvider and uses the assumed credentials
#   for both presigning PUT URLs and HEAD requests. The role's policy
#   should allow s3:PutObject, s3:GetObject, and s3:HeadObject on
#   `arn:aws:s3:::${AWS_S3_BUCKET}/${AWS_S3_KEY_PREFIX}users/*` only.
#
# AWS_S3_BUCKET
#   Required. Different per environment (dev / staging / prod) so a
#   misconfigured deploy can't write into the wrong bucket.
#
# AWS_S3_KEY_PREFIX
#   Optional. Trailing slash auto-normalised. Use to split tenants on a
#   shared bucket: `prod/`, `staging/`, `dev/{engineer}/`. Empty allowed
#   when the bucket is dedicated.
#
# Either AWS_REGION or AWS_S3_BUCKET being unset disables the
# records-audio routes — the records-text path keeps working.
apiVersion: v1
kind: Secret
metadata:
  name: aws-assume-role
type: Opaque
stringData:
  AWS_REGION: "ap-northeast-2"
  AWS_ASSUME_ROLE_ARN: "arn:aws:iam::REPLACE_ACCOUNT_ID:role/dear-baby-records-writer"
  AWS_S3_BUCKET: "dear-baby-records-REPLACE_ENV"
  AWS_S3_KEY_PREFIX: "REPLACE_ENV/"
