# Records-audio AWS configuration for the backend Deployment.
#
# DO NOT copy this file into the cluster as-is — fill in real values and
# apply, or use `kubectl create secret generic ...` to skip the
# committed-placeholder problem.
#
# Two principals are involved (the AssumeRole pattern, not IRSA):
#
#   1. Bootstrap IAM user
#      - long-lived AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY
#      - shipped via the `aws-credentials` Secret, which the backend
#        Deployment references with a required `envFrom` (see
#        k8s/deployment.yaml). The pod will not start without it.
#      - permissions: ONLY sts:AssumeRole on the writer role below.
#
#   2. Records-audio writer role (AWS_ASSUME_ROLE_ARN)
#      - assumed at startup via stscreds.AssumeRoleProvider.
#      - permissions: s3:PutObject, s3:GetObject, s3:HeadObject on
#          arn:aws:s3:::${AWS_S3_BUCKET}/${AWS_S3_KEY_PREFIX}users/*
#        and nothing else.
#
# Two-secret split below is one option; a single combined secret or
# a kustomize patch that merges with the deployment is also fine.
# What matters is that the pod's environment ends up with all the
# required vars listed below.
#
# Required env vars (backend reads these via os.Getenv):
#   AWS_ACCESS_KEY_ID         bootstrap user's access key
#   AWS_SECRET_ACCESS_KEY     bootstrap user's secret key
#   AWS_REGION                bucket region (also where STS lives)
#   AWS_ASSUME_ROLE_ARN       writer role ARN (unset in CI/local dev)
#   AWS_S3_BUCKET             different per environment
# Optional:
#   AWS_S3_KEY_PREFIX         e.g. "prod/", "staging/". Empty allowed.
#   AWS_S3_FORCE_PATH_STYLE   "1" only for MinIO/LocalStack
#   AWS_ENDPOINT_URL_S3       only for MinIO/LocalStack
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-credentials
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "REPLACE_ACCESS_KEY_ID"
  AWS_SECRET_ACCESS_KEY: "REPLACE_SECRET_ACCESS_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-records-audio
type: Opaque
stringData:
  AWS_REGION: "ap-northeast-2"
  AWS_ASSUME_ROLE_ARN: "arn:aws:iam::REPLACE_ACCOUNT_ID:role/dear-baby-records-writer"
  AWS_S3_BUCKET: "dear-baby-records-REPLACE_ENV"
  AWS_S3_KEY_PREFIX: "REPLACE_ENV/"
