# Backend-only. Do NOT copy this file into the cluster as-is; fill in
# the real key and apply with `kubectl apply -f posthog-secret.yaml`.
#
# Tip: use `kubectl create secret generic posthog-secret \
#   --from-literal=POSTHOG_API_KEY=phc_... \
#   --from-literal=POSTHOG_HOST=https://us.i.posthog.com` to avoid
# committing placeholders.
#
# Our project is on the US region — set POSTHOG_HOST accordingly. Swap
# in https://eu.i.posthog.com for EU.
#
# When this secret is absent, internal/analytics.New() returns a no-op
# client and audio_upload_url_issued (and any future server-side
# events) are silently dropped, so the deployment still boots without
# product analytics.
apiVersion: v1
kind: Secret
metadata:
  name: posthog-secret
type: Opaque
stringData:
  POSTHOG_API_KEY: "phc_REPLACE_ME"
  POSTHOG_HOST: "https://us.i.posthog.com"
