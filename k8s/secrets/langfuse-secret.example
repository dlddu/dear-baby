# Worker-only. Do NOT copy this file into the cluster as-is; fill in the
# real keys and apply with `kubectl apply -f langfuse-secret.yaml`.
#
# Tip: use `kubectl create secret generic langfuse-secret --from-literal=
#   LANGFUSE_PUBLIC_KEY=pk-lf-... --from-literal=LANGFUSE_SECRET_KEY=sk-lf-...
#   --from-literal=LANGFUSE_BASE_URL=https://us.cloud.langfuse.com` to avoid
# committing placeholders.
#
# Our account is on the US region — set LANGFUSE_BASE_URL accordingly.
# Swap in https://cloud.langfuse.com for EU.
#
# When this secret is absent, bootstrapTracing() in the worker leaves the
# OTel pipeline uninitialized and spans are dropped, so the deployment
# still functions without traces.
apiVersion: v1
kind: Secret
metadata:
  name: langfuse-secret
type: Opaque
stringData:
  LANGFUSE_PUBLIC_KEY: "pk-lf-REPLACE-ME"
  LANGFUSE_SECRET_KEY: "sk-lf-REPLACE-ME"
  LANGFUSE_BASE_URL: "https://us.cloud.langfuse.com"
