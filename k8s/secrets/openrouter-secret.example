# Worker-only. Do NOT copy this file into the cluster as-is; fill in the
# real key and apply with `kubectl apply -f openrouter-secret.yaml`.
#
# Tip: use `kubectl create secret generic openrouter-secret --from-literal=
#   OPENROUTER_API_KEY=sk-or-...` to avoid committing placeholders.
apiVersion: v1
kind: Secret
metadata:
  name: openrouter-secret
type: Opaque
stringData:
  OPENROUTER_API_KEY: "sk-or-REPLACE-ME"
