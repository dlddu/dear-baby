# Worker-only. Do NOT copy this file into the cluster as-is; fill in the
# real key and apply with `kubectl apply -f openrouter-secret.yaml`.
#
# Tip: use `kubectl create secret generic openrouter-secret \
#   --from-literal=OPENROUTER_API_KEY=sk-or-... \
#   --from-literal=OPENROUTER_MODEL=openrouter/free` to avoid committing
# placeholders.
#
# OPENROUTER_MODEL ships in this secret (not the Deployment) so operators
# can rotate the model slug alongside the key without redeploying.
# `openrouter/free` is the free-tier auto-router
# (https://openrouter.ai/openrouter/free) and is a safe default.
apiVersion: v1
kind: Secret
metadata:
  name: openrouter-secret
type: Opaque
stringData:
  OPENROUTER_API_KEY: "sk-or-REPLACE-ME"
  OPENROUTER_MODEL: "openrouter/free"
