# Backend-only. Do NOT copy this file into the cluster as-is; fill in the
# real values and apply with `kubectl apply -f aws-assume-role-secret.yaml`.
#
# What this is for: backend AssumeRole-driven access to the records-audio
# S3 bucket. When all four keys are set, the backend mounts
# /records/{id}/audio/upload-url and PATCH /records/{id} (audio attach).
# When AWS_S3_BUCKET is unset the routes return 503 and local dev keeps
# working without AWS credentials.
#
# `AWS_S3_KEY_PREFIX` is environment-scoped: keep dev/staging/prod
# disjoint so a misrouted writer cannot collide with another env. The
# prefix is normalized server-side (trailing slashes are trimmed); empty
# is allowed and means objects live at the bucket root.
#
# Tip: prefer `kubectl create secret generic aws-assume-role-secret
#   --from-literal=AWS_REGION=ap-northeast-2 ...` to avoid committing
#   placeholders.
apiVersion: v1
kind: Secret
metadata:
  name: aws-assume-role-secret
type: Opaque
stringData:
  AWS_REGION: "ap-northeast-2"
  AWS_ASSUME_ROLE_ARN: "arn:aws:iam::123456789012:role/dear-baby-records-writer"
  AWS_S3_BUCKET: "dear-baby-records-prod"
  AWS_S3_KEY_PREFIX: "prod"
