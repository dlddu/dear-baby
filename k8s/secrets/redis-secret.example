# Shared by backend + worker. Today the in-cluster Redis doesn't require
# auth (ClusterIP-only, no external exposure), so REDIS_URL is the full
# URL including any password if one is enabled later. Treat the secret
# name as the contract even if the value is currently trivial — rotating
# between auth modes should not require manifest changes.
apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
type: Opaque
stringData:
  REDIS_URL: "redis://redis:6379"
